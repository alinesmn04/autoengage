# LLM Provider: 'gemini' or 'openai' (Defaults to the first available API key if not specified)
LLM_PROVIDER=gemini

# Gemini Configuration (Highly recommended for Israel - free and works natively)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (Fallback/Secondary Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_BACKUP=your_groq_backup_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional proxy for Groq API if blocked in Israel (e.g. http://127.0.0.1:8080)
# GROQ_PROXY=
